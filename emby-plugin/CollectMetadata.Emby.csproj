<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>0.4.0</Version>
    <Description>Refresh metadata and optionally organize loose movies and episodes in Emby.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" PrivateAssets="all" />
    <PackageReference Include="System.Memory" Version="4.6.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web/settings.html;Web/settings.js" />
  </ItemGroup>
</Project>
