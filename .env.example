# Required: set a new password before starting Docker Compose.
POSTGRES_PASSWORD=

# Local-only access by default. See README before changing APP_HOST.
APP_HOST=127.0.0.1
APP_PORT=8080

# Optional: pin an image tag or digest when using compose.ghcr.yaml.
# COLLECT_METADATA_IMAGE=ghcr.io/guangl/collect-metadata:latest

# Optional: can also be set in the app's Settings page.
# TMDB_READ_ACCESS_TOKEN=
# EMBY_URL=
# EMBY_API_KEY=

# Optional: Bangumi access token for authenticated API requests.
# BANGUMI_ACCESS_TOKEN=

# Optional: writable host media directory for compose.emby-writeback.yaml.
# EMBY_WRITEBACK_MOUNT=/path/to/mounted/media

# Optional AI scraping. Use the full OpenAI-compatible chat completions URL.
# COLLECT_METADATA_AI_URL=http://ollama:11434/v1/chat/completions
# COLLECT_METADATA_AI_MODEL=
# COLLECT_METADATA_AI_API_KEY=
